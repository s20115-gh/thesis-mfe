{
  "name": "@thesis/monolith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one-unit reference build: every feature in one Vite build with route-level code splitting.",
  "scripts": {
    "dev": "vite --port 5100 --strictPort",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@thesis/contracts": "workspace:*",
    "@thesis/data": "workspace:*",
    "@thesis/feature-account": "workspace:*",
    "@thesis/feature-analytics": "workspace:*",
    "@thesis/feature-booking": "workspace:*",
    "@thesis/feature-calendar": "workspace:*",
    "@thesis/feature-catalog-staff": "workspace:*",
    "@thesis/feature-checkout": "workspace:*",
    "@thesis/feature-discovery": "workspace:*",
    "@thesis/feature-venue": "workspace:*",
    "@thesis/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
